# qmd collections. Paths are relative to this repo root.
#
# NOTE: `conclusions` is a DELIBERATELY separate collection, excluded from the
# research-facing `vault` collection (which maps vault/loops only). Research
# routes query wisdom / vault / transcripts; keeping Dreamer's own written
# conclusions out of those is what stops its prior output coming back as
# evidence for itself (constitution rule 13). Do not merge these paths.
collections:
  wisdom:
    path: wisdom_md
  vault:
    path: vault/loops
  transcripts:
    path: vault/sources/transcripts
  conclusions:
    path: vault/conclusions
  # The knowledge frontier's own pages (items, lessons, pre-mortems), searched by
  # scripts/qmd_client.py and refreshed by bin/frontier.sh. Build it once with
  # `qmd update && qmd embed`, or let the first nightly frontier run do it.
  frontier:
    path: vault/frontier
